{
  "name": "latch-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright test && node scripts/e2e-gallery.mjs",
    "test:e2e:staging": "LATCH_E2E_PROJECTS=staging LATCH_E2E_TARGET=staging playwright test",
    "test:e2e:staging:report": "LATCH_E2E_PROJECTS=staging LATCH_E2E_TARGET=staging playwright test && node scripts/e2e-gallery.mjs",
    "test:e2e:cf": "LATCH_E2E_PROJECTS=cloudflare LATCH_E2E_TARGET=cloudflare playwright test",
    "test:e2e:cf:report": "LATCH_E2E_PROJECTS=cloudflare LATCH_E2E_TARGET=cloudflare playwright test && node scripts/e2e-gallery.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "@fontsource/zen-old-mincho": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^17.0.0",
    "vitest": "^3.0.0"
  }
}
