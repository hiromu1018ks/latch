{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latch-api",
  "main": "entry.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  // フロント配信(Workers Assets)。build済みfrontend/dist/clientを同一オリジンで
  // 配信し、API/probe経路はworkerを先行させる(SPA fallbackに飲まれないよう
  // run_worker_firstで明示。配列形式はwrangler>=4.20・実効4.149)。
  "assets": {
    "directory": "../../frontend/dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health", "/probe/*"]
  },
  // LATCH_LLM_MODEはここに書かない: 現行wranglerはvarsと同名secretの登録を
  // 拒否するため(code 10053)、実配備のreal化はwrangler secret
  // LATCH_LLM_MODE=realでのみ行う。コード既定値が"stub"
  // (state.build_state・pipeline.build_pipeline)のため、secret未設定の
  // ローカルdev/miniflare・CIは常にstubのまま。ロールバックは
  // `wrangler secret delete LATCH_LLM_MODE` + make cf-deploy。
  "vars": {
    "LATCH_ENV": "api",
    "PROBE_TEXT_VAR": "probe-value"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "latch-core",
      "database_id": "f40367ac-7631-4506-a083-c52e7ab51787"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "latch-jobs-probe"
      }
    ],
    "consumers": [
      {
        "queue": "latch-jobs-probe",
        "max_batch_size": 10,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
