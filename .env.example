# LATCH 環境変数のテンプレート(このファイルはコミットされる。実値は .env に書く)
# .env は .gitignore 済み(git に絶対入れない)。compose の変数展開と backend Settings が読む。

# --- LLM プロバイダ(T1 v0.2) ---
# Parser系統(第一候補): Anthropic Claude API・Haiku 4.5(G1精度ゲートで使用)
LATCH_ANTHROPIC_API_KEY=
# Embedding系統: Google Gemini API有料 tier(gemini-embedding-001)
LATCH_GEMINI_API_KEY=
# Jev系統(M2で使用): TypeSafe Jev(api.typesafe.ai)
LATCH_TYPESAFE_API_KEY=

# --- ci環境(compose.yaml 既定値があるため通常は未設定でよい) ---
# LATCH_DATABASE_URL=postgresql+asyncpg://latch:latch@127.0.0.1:5432/latch
# LATCH_REDIS_URL=redis://127.0.0.1:6379/0
